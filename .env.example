# ==============================================================================
# CodeSentinel Environment Configuration Template (.env.example)
# Note: Copy this file to .env and configure appropriate credentials for your environment.
# NO REAL SECRETS OR SENSITIVE PASSWORDS ARE STORED HERE.
# ==============================================================================

# Application & Runtime
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME=CodeSentinel
API_V1_PREFIX=/api/v1
SECRET_KEY=codesentinel-development-secret-key-change-in-production-1234567890

# Frontend URL & CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8000"]
VITE_API_URL=http://localhost:8000

# PostgreSQL Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=codesentinel
POSTGRES_PASSWORD=codesentinel_secret
POSTGRES_DB=codesentinel_db

# Neo4j Knowledge Graph (Relationships Only)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=codesentinel_graph_secret

# Qdrant Vector DB (RAG & Code Embeddings)
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=codesentinel_embeddings

# Redis (Task Queue & Cache)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_JOB_QUEUE=codesentinel:jobs:queue
REDIS_JOB_PREFIX=codesentinel:job:

# AI LLM Provider Keys (Optional for Phase 0 Stubs)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Docker Sandbox Execution Infra (Phase 4 Isolated Environment)
SANDBOX_DOCKER_NETWORK=codesentinel_sandbox_net
SANDBOX_TIMEOUT_SECONDS=300
